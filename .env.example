# Copy to .env and fill in. Never commit .env.
# A long random phrase. Keep it forever: it fixes the agent address.
AGENT_SEED=replace-with-a-long-random-secret-phrase
AGENT_NAME=vendor-check
AGENT_PORT=8001

# Optional LLM layer. Leave LLM_API_KEY blank to run without it.
# LLM_PROVIDER: asi1 or openai (any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=asi1
LLM_API_KEY=
LLM_MODEL=asi1-mini
LLM_BASE_URL=
LLM_EXTRACT=1
LLM_FLAGS=0
LLM_SUMMARY=0
